{
  "name": "typeboy",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:typeboy": "turbo dev  --filter=typeboy",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "ui": "pnpm --filter @repo/ui ui"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "2.1.1",
    "autoprefixer": "^10",
    "eslint": "^8",
    "postcss": "^8",
    "postcss-load-config": "^6",
    "tailwindcss": "^3.4.10",
    "typescript": "^5"
  },
  "packageManager": "pnpm@8.9.0",
  "engines": {
    "node": ">=18"
  }
}
